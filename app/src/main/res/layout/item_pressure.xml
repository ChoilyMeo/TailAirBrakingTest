<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_white"
    android:paddingRight="@dimen/space_15"
    android:paddingLeft="@dimen/space_15">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_10"
        android:layout_marginBottom="@dimen/space_10">
        <TextView
            android:id="@+id/item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:02:32"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14"
            android:layout_marginRight="@dimen/space_10"
            android:layout_alignParentRight="true"/>

        <TextView
            android:id="@+id/item_pressure_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/space_10"
            android:text="压力值:"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14" />

        <TextView
            android:id="@+id/item_pressureValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/item_pressure_text"
            android:text="600"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14" />
    </RelativeLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/color_gray_c"
        android:layout_marginBottom="@dimen/space_1"
        android:layout_marginTop="@dimen/space_1"/>
</LinearLayout>