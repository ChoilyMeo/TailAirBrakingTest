<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/space_15"
    android:paddingRight="@dimen/space_15">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_10"
        android:layout_marginBottom="@dimen/space_5">
        <TextView
            android:id="@+id/item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="状态"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14"
            android:layout_alignParentRight="true"/>

        <TextView
            android:id="@+id/item_testName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="漏泄试验"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14"
            android:layout_toLeftOf="@id/item_status"
            android:layout_marginRight="@dimen/space_10"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_5">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主管压力："
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
            <TextView
                android:id="@+id/item_pressureValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="600"
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保压时间："
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
            <TextView
                android:id="@+id/item_keepTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="600"
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="漏  泄  量："
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
            <TextView
                android:id="@+id/item_leakValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="600"
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_5">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="减  压  量："
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
            <TextView
                android:id="@+id/item_dropValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="600"
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="减压时间："
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
            <TextView
                android:id="@+id/item_dropTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="600"
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="减压速度："
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
            <TextView
                android:id="@+id/item_dropSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="600"
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="时间："
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14"
            android:layout_marginRight="@dimen/space_10" />
        <TextView
            android:id="@+id/item_testStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11:23:55"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14"
            android:layout_marginRight="@dimen/space_10" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="~"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14"
            android:layout_marginRight="@dimen/space_10" />
        <TextView
            android:id="@+id/item_testEndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16:23:55"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14"
            android:layout_marginRight="@dimen/space_10" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/color_gray_c"
        android:layout_marginBottom="@dimen/space_1"
        android:layout_marginTop="@dimen/space_7"/>
</LinearLayout>