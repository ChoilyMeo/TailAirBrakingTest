<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_white"
    tools:context=".activitys.SearchActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/space_15"
        android:paddingRight="@dimen/space_15"
        android:paddingBottom="@dimen/space_5"
        android:paddingTop="@dimen/space_10"
        android:background="@color/color_bg">
        <RelativeLayout
            android:id="@+id/relative_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/starttime_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/color_black"
                    android:text="选择开始时间"
                    android:layout_marginRight="@dimen/space_5"
                    android:layout_marginBottom="@dimen/space_6"/>
                <TextView
                    android:id="@+id/start_date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/color_orange"
                    android:text="年--月--日"/>
            </LinearLayout>

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@mipmap/icon_to"
                android:layout_centerInParent="true"/>

            <LinearLayout
                android:id="@+id/endtime_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/color_black"
                    android:text="选择结束时间"
                    android:layout_marginBottom="@dimen/space_6"/>
                <TextView
                    android:id="@+id/end_date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/color_orange"
                    android:text="年--月--日"/>

            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_7">
            <TextView
                android:id="@+id/cancle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/space_25"
                android:text="取消"
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_14"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_white_line_gray"
                android:paddingRight="@dimen/space_10"
                android:paddingLeft="@dimen/space_10"
                android:gravity="center"
                android:layout_marginLeft="@dimen/space_5"/>

            <TextView
                android:id="@+id/btn_query"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/space_25"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@id/btn_clear"
                android:background="@drawable/shape_corn_login"
                android:gravity="center"
                android:paddingLeft="@dimen/space_10"
                android:paddingRight="@dimen/space_10"
                android:text="查询"
                android:textColor="@color/color_white"
                android:textSize="@dimen/text_size_14" />

            <TextView
                android:id="@+id/btn_clear"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/space_25"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/space_5"
                android:layout_toLeftOf="@id/cancle"
                android:background="@drawable/shape_corn_login"
                android:gravity="center"
                android:paddingLeft="@dimen/space_10"
                android:paddingRight="@dimen/space_10"
                android:text="清空"
                android:textColor="@color/color_white"
                android:textSize="@dimen/text_size_14" />
            <LinearLayout
                android:layout_toLeftOf="@id/btn_query"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:orientation="horizontal"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:layout_marginRight="@dimen/space_5">
                <TextView
                    android:id="@+id/txt_checi"
                    android:text="车次:"
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/color_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/edt_trainNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:background="@color/color_white"
                    android:hint="请输入车次"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColorHint="@color/color_gray_c"
                    android:textSize="@dimen/text_size_14"
                    android:layout_marginLeft="@dimen/space_10"
                    android:paddingTop="@dimen/space_5"
                    android:paddingBottom="@dimen/space_5"
                    android:paddingLeft="@dimen/space_10"
                    android:paddingRight="@dimen/space_10"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/color_gray_c"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/line"
        android:padding="@dimen/space_10"
        android:background="@color/color_bg">

        <TextView
            android:id="@+id/tv_chart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/space_5"
            android:layout_weight="1"
            android:background="@drawable/shape_corn_login"
            android:gravity="center"
            android:paddingTop="@dimen/space_5"
            android:paddingBottom="@dimen/space_5"
            android:text="压力曲线"
            android:textColor="@color/color_white"
            android:textSize="@dimen/text_size_14"
            android:visibility="visible" />
        <TextView
            android:id="@+id/tv_pressure"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="压力明细"
            android:textColor="@color/color_white"
            android:textSize="@dimen/text_size_14"
            android:background="@drawable/shape_corn_login"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="@dimen/space_5"
            android:paddingBottom="@dimen/space_5"
            android:layout_marginLeft="@dimen/space_5"
            android:layout_marginRight="@dimen/space_5"/>
        <TextView
            android:id="@+id/tv_test"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="试验明细"
            android:textColor="@color/color_white"
            android:textSize="@dimen/text_size_14"
            android:background="@drawable/shape_corn_login"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="@dimen/space_5"
            android:paddingBottom="@dimen/space_5"
            android:layout_marginLeft="@dimen/space_5"/>
    </LinearLayout>
    <ListView
        android:id="@+id/mListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:listSelector="@color/color_bg"></ListView>

</LinearLayout>