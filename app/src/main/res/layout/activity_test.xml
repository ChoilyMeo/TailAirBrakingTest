            android:layout_height="wrap_content"
            android:text="股道:2"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14"
            android:layout_marginRight="@dimen/space_10" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="车次:g1233"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14"
            android:layout_marginRight="@dimen/space_10"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="辆数:1"
            android:textColor="@color/color_black"
            android:textSize="@dimen/text_size_14"
            android:layout_marginRight="@dimen/space_10" />
