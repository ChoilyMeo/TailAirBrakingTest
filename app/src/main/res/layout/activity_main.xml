<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Activitys.MainActivity"
    android:background="@color/color_white">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_50"
        android:background="@drawable/bg_gradient_color">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_18"
            android:text="@string/app_name"
            android:textColor="@color/color_white"
            android:layout_centerInParent="true"/>
        <TextView
            android:id="@+id/tv_setting"
            android:layout_width="@dimen/space_40"
            android:layout_height="match_parent"
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/color_white"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:id="@+id/tv_test_serial_port"
            android:layout_width="@dimen/space_40"
            android:layout_height="match_parent"
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/color_white"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>

    <android.support.v7.widget.CardView
        android:id="@+id/tv_testWind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentPaddingRight="@dimen/space_12"
        app:contentPaddingLeft="@dimen/space_12"
        android:layout_marginLeft="@dimen/space_20"
        android:layout_marginRight="@dimen/space_20"
        android:layout_marginTop="@dimen/space_10"
        app:cardElevation="@dimen/space_2"
        android:background="@color/color_white">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_50"
            android:text="试风"
            android:textSize="@dimen/text_size_15"
            android:textColor="@color/color_black"
            android:gravity="center_vertical"
            android:drawableRight="@mipmap/ic_jiantou"
            android:drawableLeft="@mipmap/ic_jiantou"
            android:drawablePadding="@dimen/space_10"
            android:paddingLeft="@dimen/space_5"
            android:paddingRight="@dimen/space_5"/>
    </android.support.v7.widget.CardView>
    <android.support.v7.widget.CardView
        android:id="@+id/tv_enginery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentPaddingRight="@dimen/space_12"
        app:contentPaddingLeft="@dimen/space_12"
        android:layout_marginLeft="@dimen/space_20"
        android:layout_marginRight="@dimen/space_20"
        android:layout_marginTop="@dimen/space_10"
        app:cardElevation="@dimen/space_2"
        android:background="@color/color_white">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_50"
            android:text="机能"
            android:textSize="@dimen/text_size_15"
            android:textColor="@color/color_black"
            android:gravity="center_vertical"
            android:drawableRight="@mipmap/ic_jiantou"
            android:drawableLeft="@mipmap/ic_jiantou"
            android:drawablePadding="@dimen/space_10"
            android:paddingLeft="@dimen/space_5"
            android:paddingRight="@dimen/space_5"/>
    </android.support.v7.widget.CardView>
    <android.support.v7.widget.CardView
        android:id="@+id/tv_test"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentPaddingRight="@dimen/space_12"
        app:contentPaddingLeft="@dimen/space_12"
        android:layout_marginLeft="@dimen/space_20"
        android:layout_marginRight="@dimen/space_20"
        android:layout_marginTop="@dimen/space_10"
        app:cardElevation="@dimen/space_2"
        android:background="@color/color_white">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_50"
            android:text="校验"
            android:textSize="@dimen/text_size_15"
            android:textColor="@color/color_black"
            android:gravity="center_vertical"
            android:drawableRight="@mipmap/ic_jiantou"
            android:drawableLeft="@mipmap/ic_jiantou"
            android:drawablePadding="@dimen/space_10"
            android:paddingLeft="@dimen/space_5"
            android:paddingRight="@dimen/space_5"/>
    </android.support.v7.widget.CardView>
    <android.support.v7.widget.CardView
        android:id="@+id/tv_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentPaddingRight="@dimen/space_12"
        app:contentPaddingLeft="@dimen/space_12"
        android:layout_marginLeft="@dimen/space_20"
        android:layout_marginRight="@dimen/space_20"
        android:layout_marginTop="@dimen/space_10"
        app:cardElevation="@dimen/space_2"
        android:background="@color/color_white">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_50"
            android:text="查询"
            android:textSize="@dimen/text_size_15"
            android:textColor="@color/color_black"
            android:gravity="center_vertical"
            android:drawableRight="@mipmap/ic_jiantou"
            android:drawableLeft="@mipmap/ic_jiantou"
            android:drawablePadding="@dimen/space_10"
            android:paddingLeft="@dimen/space_5"
            android:paddingRight="@dimen/space_5"/>
    </android.support.v7.widget.CardView>
</LinearLayout>