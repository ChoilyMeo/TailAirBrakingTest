<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activitys.MainActivity"
    android:background="@color/color_white">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_50"
        android:background="@drawable/bg_gradient_color">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_18"
            android:text="@string/app_name"
            android:textColor="@color/color_white"
            android:layout_centerInParent="true"/>
        <TextView
            android:id="@+id/tv_setting"
            android:layout_width="@dimen/space_40"
            android:layout_height="match_parent"
            android:textSize="@dimen/text_size_18"
            android:textColor="@color/color_white"
            android:layout_alignParentLeft="true"/>

        <TextView
            android:id="@+id/tv_test_serial_port"
            android:layout_width="@dimen/space_40"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:textColor="@color/color_white"
            android:textSize="@dimen/text_size_18" />
    </RelativeLayout>

    <android.support.v7.widget.CardView
        android:id="@+id/tv_testWind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:orientation="vertical">
        <ImageView
            android:id="@+id/image_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/test"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="试风"
            android:textSize="@dimen/text_size_24"
            android:layout_marginTop="@dimen/space_10"
            android:layout_marginBottom="@dimen/space_20"
            android:textColor="@color/color_black"
            android:gravity="center"/>
        </LinearLayout>
    </android.support.v7.widget.CardView>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/color_gray_c"/>
    <android.support.v7.widget.CardView
        android:id="@+id/tv_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:orientation="vertical">
        <ImageView
            android:id="@+id/image_query"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@mipmap/query"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="查询"
            android:textSize="@dimen/text_size_24"
            android:textColor="@color/color_black"
            android:layout_marginTop="@dimen/space_10"
            android:layout_marginBottom="@dimen/space_20"
            android:gravity="center"/>
        </LinearLayout>
    </android.support.v7.widget.CardView>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/color_gray_c"/>
    <android.support.v7.widget.CardView
        android:id="@+id/tv_exit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/image_exit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@mipmap/exit"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="退出"
                android:textSize="@dimen/text_size_24"
                android:textColor="@color/color_black"
                android:layout_marginTop="@dimen/space_10"
                android:layout_marginBottom="@dimen/space_20"
                android:gravity="center"/>
        </LinearLayout>
    </android.support.v7.widget.CardView>
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/color_gray_c"/>
</LinearLayout>